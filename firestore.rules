rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isPublicProfile() {
      return resource.data.publicProfileSlug is string &&
        resource.data.publicProfileSlug.size() >= 3 &&
        // Explicit false opts out; missing flag + slug = legacy live
        resource.data.get('publicProfileLive', true) == true;
    }

    function isValidUsageUpdate() {
      let diff = request.resource.data.diff(resource.data);
      let allowedFields = ['cards', 'events', 'draftsPerCard', 'updatedAt'];

      return diff.affectedKeys().hasOnly(allowedFields) &&
        (
          !diff.changedKeys().hasAny(['cards']) ||
          (resource.data.cards == null && request.resource.data.cards == 1) ||
          request.resource.data.cards == resource.data.cards + 1
        ) &&
        (
          !diff.changedKeys().hasAny(['draftsPerCard']) ||
          diff.changedKeys().hasOnly(['draftsPerCard', 'updatedAt'])
        );
    }

    match /business-cards/{cardId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Public profiles readable by slug; private fields still live on the same doc
    // (clients must not render sensitive fields for non-owners).
    match /users/{userId} {
      allow read: if isOwner(userId) || isPublicProfile() || isAdmin();
      allow create: if isAuthenticated() && userId == request.auth.uid;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /usage_stats/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && userId == request.auth.uid;
      allow update: if isOwner(userId) && isValidUsageUpdate();
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /email-drafts/{draftId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /events/{eventId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /stripe_customers/{userId} {
      allow read: if isOwner(userId);
    }

    // Funnel / product events written by authenticated clients (optional)
    match /funnel_events/{eventId} {
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
    }
  }
}
