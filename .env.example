# Client (Vite) — public, no secrets
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_STRIPE_PUBLISHABLE_KEY=
# Optional model override for docs/UI only — real AI calls use server OPENAI_*
VITE_OPENAI_MODEL=gpt-5.5
VITE_APP_ENV=development

# Server (Express / Vercel) — keep secret
PORT=3000
APP_URL=http://localhost:5173
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BASIC_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_BASIC_YEARLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=

AZURE_STORAGE_CONNECTION_STRING=

# Prefer Resend (set RESEND_API_KEY). Otherwise Zoho/SMTP:
RESEND_API_KEY=
EMAIL_FROM=BilloAI <you@your-verified-domain.com>
# EMAIL_HOST=
# EMAIL_PORT=465
# EMAIL_USER=
# EMAIL_PASS=

# Vercel Cron Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# Optional dedicated HMAC for unsubscribe links (falls back to CRON_SECRET)
UNSUBSCRIBE_SECRET=
